{
    "name": "accessibility-exchange/platform",
    "type": "project",
    "description": "The Accessibility Exchange Platform.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "version": "1.5.2",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3|^8.4",
        "axlon/laravel-postal-code-validation": "^3.7",
        "blade-ui-kit/blade-heroicons": "^2.4",
        "blade-ui-kit/blade-icons": "^1.7",
        "chinleung/laravel-locales": "^2.1",
        "chinleung/laravel-multilingual-routes": "^4.1",
        "codeat3/blade-forkawesome": "^1.10",
        "codezero/laravel-unique-translation": "^4.3",
        "commerceguys/addressing": "^2.2",
        "commerceguys/intl": "^2.0",
        "elhebert/laravel-sri": "^3.3",
        "filament/filament": "^3.2",
        "filament/spatie-laravel-settings-plugin": "^3.2",
        "fluid-project/hearth-components": "dev-main",
        "guzzlehttp/guzzle": "^7.9",
        "hedronium/spaceless-blade": "^3.0",
        "laravel/fortify": "^1.24",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.10",
        "laravel/vonage-notification-channel": "^3.3",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^3.5",
        "makeabledk/laravel-eloquent-status": "^4.1",
        "propaganistas/laravel-phone": "^5.3",
        "ralphjsmit/livewire-urls": "^1.4",
        "shiftonelabs/laravel-cascade-deletes": "^2.0",
        "spatie/laravel-backup": "^9.1",
        "spatie/laravel-ciphersweet": "^1.6",
        "spatie/laravel-collection-macros": "^7.14",
        "spatie/laravel-cookie-consent": "^3.3",
        "spatie/laravel-db-snapshots": "^2.6",
        "spatie/laravel-flash": "^1.10",
        "spatie/laravel-google-fonts": "^1.4",
        "spatie/laravel-ignition": "^2.8",
        "spatie/laravel-login-link": "^1.3",
        "spatie/laravel-options": "^1.1",
        "spatie/laravel-schemaless-attributes": "^2.5",
        "spatie/laravel-sluggable": "^3.6",
        "spatie/laravel-translatable": "^6.8",
        "staudenmeir/eloquent-has-many-deep": "^1.20",
        "staudenmeir/eloquent-has-many-deep-contracts": "^1.2",
        "staudenmeir/laravel-merged-relations": "^1.9",
        "staudenmeir/laravel-migration-views": "^1.10",
        "symfony/http-foundation": "^7.0",
        "theiconic/name-parser": "^1.2",
        "umpirsky/language-list": "^1.1",
        "worksome/request-factories": "^3.3"
    },
    "require-dev": {
        "amirami/localizator": "^0.13-alpha",
        "barryvdh/laravel-debugbar": "^3.6",
        "barryvdh/laravel-ide-helper": "^3.2",
        "calebporzio/sushi": "^2.4",
        "fakerphp/faker": "^1.19",
        "larastan/larastan": "^3.0",
        "laravel/dusk": "^8.2",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.5",
        "nunomaduro/collision": "^8.5",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-faker": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^11.0",
        "plannr/laravel-fast-refresh-database": "^1.2"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.3"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan filament:upgrade"
        ],
        "analyze": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "localize": [
            "@php artisan localize en,fr --remove-missing"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test"
        ],
        "test-coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test --coverage"
        ]
    }
}
